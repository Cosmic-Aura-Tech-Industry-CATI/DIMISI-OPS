# Backend API Base Path (defaults to /api/v1 via Vite Proxy)
VITE_API_BASE_URL=

# Optional Dev Backend Proxy URL (defaults to http://127.0.0.1:5000)
VITE_DEV_BACKEND_URL=

# Firebase Web Client Configuration (For Google SSO Authentication)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
