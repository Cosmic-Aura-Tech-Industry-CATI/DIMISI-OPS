# Backend API Base Path (defaults to /api/v1 via Vite Proxy)
VITE_API_BASE_URL=/api/v1

# Optional Dev Backend Proxy URL (defaults to http://127.0.0.1:5000)
VITE_DEV_BACKEND_URL=http://127.0.0.1:5000

# Firebase Web Client Configuration (For Google SSO Authentication)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=dimisi-ops.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dimisi-ops
VITE_FIREBASE_STORAGE_BUCKET=dimisi-ops.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
